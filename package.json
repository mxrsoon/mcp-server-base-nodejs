{
  "name": "mcp-server-base-nodejs",
  "version": "0.1.0",
  "description": "Base de servidor MCP em TypeScript com tools declaradas como métodos de classe, schemas e descrições inferidos dos tipos e do JSDoc.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ttsc",
    "typecheck": "ttsc --project tsconfig.test.json",
    "test": "ttsx --project tsconfig.test.json test/tools.test.ts",
    "dev": "ttsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typia/mcp": "^14.0.4",
    "typia": "^14.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "ttsc": "^0.28.3",
    "typescript": "^7.0.2"
  }
}
